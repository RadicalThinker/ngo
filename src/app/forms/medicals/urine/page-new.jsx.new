"use client";

import { useState } from "react";

export default function UrineSugarChart() {
  // Reduce number of entries for better fit on screen
  const entries = Array.from({ length: 4 }, (_, i) => i + 1);

  // State for medication rows
  const [medications, setMedications] = useState([
    { id: 1, name: "", dosages: Array(entries.length).fill("") },
  ]);

  // State for insulin rows
  const [insulins, setInsulins] = useState([
    { id: 1, type: "", dosages: Array(entries.length).fill("") },
  ]);

  // Add new medication row
  const addMedication = () => {
    const newId =
      medications.length > 0
        ? Math.max(...medications.map((m) => m.id)) + 1
        : 1;
    setMedications([
      ...medications,
      { id: newId, name: "", dosages: Array(entries.length).fill("") },
    ]);
  };

  // Add new insulin row
  const addInsulin = () => {
    const newId =
      insulins.length > 0 ? Math.max(...insulins.map((i) => i.id)) + 1 : 1;
    setInsulins([
      ...insulins,
      { id: newId, type: "", dosages: Array(entries.length).fill("") },
    ]);
  };

  // Handle medication name change
  const handleMedicationNameChange = (id, value) => {
    setMedications(
      medications.map((med) => (med.id === id ? { ...med, name: value } : med))
    );
  };

  // Handle medication dosage change
  const handleMedicationDosageChange = (medId, entryIndex, value) => {
    setMedications(
      medications.map((med) => {
        if (med.id === medId) {
          const newDosages = [...med.dosages];
          newDosages[entryIndex] = value;
          return { ...med, dosages: newDosages };
        }
        return med;
      })
    );
  };

  // Handle insulin type change
  const handleInsulinTypeChange = (id, value) => {
    setInsulins(
      insulins.map((ins) => (ins.id === id ? { ...ins, type: value } : ins))
    );
  };

  // Handle insulin dosage change
  const handleInsulinDosageChange = (insId, entryIndex, value) => {
    setInsulins(
      insulins.map((ins) => {
        if (ins.id === insId) {
          const newDosages = [...ins.dosages];
          newDosages[entryIndex] = value;
          return { ...ins, dosages: newDosages };
        }
        return ins;
      })
    );
  };

  return (
    <div className="p-4 w-full max-w-6xl mx-auto">
      <h1 className="text-2xl font-bold mb-6 text-center">URINE SUGAR CHART</h1>

      {/* Color of Urine Table */}
      <div className="mb-8">
        <h2 className="text-lg font-semibold mb-2">Color of urine</h2>
        <div className="overflow-x-auto shadow rounded-lg pb-2">
          <table className="w-full border-collapse border border-gray-400 mb-2">
            <thead>
              <tr className="bg-gray-100">
                <th
                  className="border border-gray-300 p-2 text-left"
                  style={{ minWidth: "100px" }}
                >
                  Color of urine
                </th>
                {entries.map((entry) => (
                  <th
                    key={entry}
                    className="border border-gray-300 p-2"
                    style={{ minWidth: "120px" }}
                  >
                    <div className="flex flex-col gap-1">
                      <input
                        type="time"
                        className="text-xs p-1 border rounded w-full"
                      />
                      <input
                        type="date"
                        className="text-xs p-1 border rounded w-full"
                      />
                    </div>
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {["Red", "Orange", "Yellow", "Green", "Blue"].map((color) => (
                <tr key={color}>
                  <td className="border border-gray-300 p-2">{color}</td>
                  {entries.map((entry) => (
                    <td
                      key={`${color}-${entry}`}
                      className="border border-gray-300"
                    >
                      <input
                        type="text"
                        className="w-full p-1 border-0 focus:ring-0 text-center"
                        placeholder="Result"
                      />
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      {/* Anti-Diabetic Medication Table */}
      <div className="mb-8">
        <h2 className="text-lg font-semibold mb-2">Anti-Diabetic</h2>
        <div className="overflow-x-auto shadow rounded-lg pb-2">
          <table className="w-full border-collapse border border-gray-400 mb-2">
            <thead>
              <tr className="bg-gray-100">
                <th
                  className="border border-gray-300 p-2 text-left"
                  style={{ minWidth: "120px" }}
                >
                  Medication (dosage)
                </th>
                {entries.map((entry) => (
                  <th
                    key={entry}
                    className="border border-gray-300 p-2"
                    style={{ minWidth: "120px" }}
                  >
                    <div className="flex flex-col gap-1">
                      <input
                        type="time"
                        className="text-xs p-1 border rounded w-full"
                      />
                      <input
                        type="date"
                        className="text-xs p-1 border rounded w-full"
                      />
                    </div>
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {medications.map((medication, index) => (
                <tr key={medication.id}>
                  <td className="border border-gray-300 p-2">
                    <input
                      type="text"
                      className="w-full p-1 border border-gray-300 rounded"
                      placeholder="Medication name"
                      value={medication.name}
                      onChange={(e) =>
                        handleMedicationNameChange(
                          medication.id,
                          e.target.value
                        )
                      }
                    />
                  </td>
                  {entries.map((entry, entryIndex) => (
                    <td
                      key={`med-${medication.id}-${entry}`}
                      className="border border-gray-300"
                    >
                      <input
                        type="text"
                        className="w-full p-1 border-0 focus:ring-0 text-center"
                        placeholder="Dosage"
                        value={medication.dosages[entryIndex]}
                        onChange={(e) =>
                          handleMedicationDosageChange(
                            medication.id,
                            entryIndex,
                            e.target.value
                          )
                        }
                      />
                    </td>
                  ))}
                </tr>
              ))}
              {/* Add more medications button */}
              <tr>
                <td
                  colSpan={entries.length + 1}
                  className="border border-gray-300 p-2 text-center"
                >
                  <button
                    type="button"
                    onClick={addMedication}
                    className="text-blue-600 hover:text-blue-800 flex items-center mx-auto"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      className="h-5 w-5 mr-1"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path
                        strokeLinecap="round"
                        strokeLinejoin="round"
                        strokeWidth={2}
                        d="M12 4v16m8-8H4"
                      />
                    </svg>
                    Add Another Medication
                  </button>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      {/* Insulin Table */}
      <div className="mb-8">
        <h2 className="text-lg font-semibold mb-2">Insulin</h2>
        <div className="overflow-x-auto shadow rounded-lg pb-2">
          <table className="w-full border-collapse border border-gray-400 mb-2">
            <thead>
              <tr className="bg-gray-100">
                <th
                  className="border border-gray-300 p-2 text-left"
                  style={{ minWidth: "120px" }}
                >
                  Insulin (dosage)
                </th>
                {entries.map((entry) => (
                  <th
                    key={entry}
                    className="border border-gray-300 p-2"
                    style={{ minWidth: "120px" }}
                  >
                    <div className="flex flex-col gap-1">
                      <input
                        type="time"
                        className="text-xs p-1 border rounded w-full"
                      />
                      <input
                        type="date"
                        className="text-xs p-1 border rounded w-full"
                      />
                    </div>
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {insulins.map((insulin, index) => (
                <tr key={insulin.id}>
                  <td className="border border-gray-300 p-2">
                    <input
                      type="text"
                      className="w-full p-1 border border-gray-300 rounded"
                      placeholder="Insulin type"
                      value={insulin.type}
                      onChange={(e) =>
                        handleInsulinTypeChange(insulin.id, e.target.value)
                      }
                    />
                  </td>
                  {entries.map((entry, entryIndex) => (
                    <td
                      key={`insulin-${insulin.id}-${entry}`}
                      className="border border-gray-300"
                    >
                      <input
                        type="text"
                        className="w-full p-1 border-0 focus:ring-0 text-center"
                        placeholder="Dosage"
                        value={insulin.dosages[entryIndex]}
                        onChange={(e) =>
                          handleInsulinDosageChange(
                            insulin.id,
                            entryIndex,
                            e.target.value
                          )
                        }
                      />
                    </td>
                  ))}
                </tr>
              ))}
              {/* Add more insulin button */}
              <tr>
                <td
                  colSpan={entries.length + 1}
                  className="border border-gray-300 p-2 text-center"
                >
                  <button
                    type="button"
                    onClick={addInsulin}
                    className="text-blue-600 hover:text-blue-800 flex items-center mx-auto"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      className="h-5 w-5 mr-1"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path
                        strokeLinecap="round"
                        strokeLinejoin="round"
                        strokeWidth={2}
                        d="M12 4v16m8-8H4"
                      />
                    </svg>
                    Add Another Insulin
                  </button>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <div className="mt-8 mb-4 text-center">
        <button className="bg-blue-600 hover:bg-blue-700 text-white py-2 px-8 rounded-md shadow-md transition duration-300 ease-in-out transform hover:scale-105">
          Save Chart
        </button>
      </div>
    </div>
  );
}
