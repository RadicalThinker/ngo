'use client'

export default function UrineSugarChart() {
  // Reduce number of entries for better fit on screen
  const entries = Array.from({ length: 4 }, (_, i) => i + 1);

  return (
    <div className="p-4 w-full max-w-6xl mx-auto">
      <h1 className="text-2xl font-bold mb-6 text-center">URINE SUGAR CHART</h1>
      
      {/* Color of Urine Table */}
      <div className="mb-8">
        <h2 className="text-lg font-semibold mb-2">Color of urine</h2>
        <div className="overflow-x-auto shadow rounded-lg pb-2">
          <table className="w-full border-collapse border border-gray-400 mb-2">
            <thead>
              <tr className="bg-gray-100">
                <th className="border border-gray-300 p-2 text-left" style={{ minWidth: "100px" }}>Color of urine</th>
                {entries.map((entry) => (
                  <th key={entry} className="border border-gray-300 p-2" style={{ minWidth: "120px" }}>
                    <div className="flex flex-col gap-1">
                      <input 
                        type="time" 
                        className="text-xs p-1 border rounded w-full"
                      />
                      <input 
                        type="date" 
                        className="text-xs p-1 border rounded w-full"
                      />
                    </div>
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {['Red', 'Orange', 'Yellow', 'Green', 'Blue'].map((color) => (
                <tr key={color}>
                  <td className="border border-gray-300 p-2">{color}</td>
                  {entries.map((entry) => (
                    <td key={`${color}-${entry}`} className="border border-gray-300">
                      <input 
                        type="text" 
                        className="w-full p-1 border-0 focus:ring-0 text-center" 
                        placeholder="Result"
                      />
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
      
      {/* Anti-Diabetic Medication Table */}
      <div className="mb-8">
        <h2 className="text-lg font-semibold mb-2">Anti-Diabetic</h2>
        <div className="overflow-x-auto shadow rounded-lg pb-2">
          <table className="w-full border-collapse border border-gray-400 mb-2">
            <thead>
              <tr className="bg-gray-100">
                <th className="border border-gray-300 p-2 text-left" style={{ minWidth: "120px" }}>Medication (dosage)</th>
                {entries.map((entry) => (
                  <th key={entry} className="border border-gray-300 p-2" style={{ minWidth: "120px" }}>
                    <div className="flex flex-col gap-1">
                      <input 
                        type="time" 
                        className="text-xs p-1 border rounded w-full"
                      />
                      <input 
                        type="date" 
                        className="text-xs p-1 border rounded w-full"
                      />
                    </div>
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              <tr>
                <td className="border border-gray-300 p-2">
                  <input 
                    type="text" 
                    className="w-full p-1 border border-gray-300 rounded" 
                    placeholder="Medication name"
                  />
                </td>
                {entries.map((entry) => (
                  <td key={`med-${entry}`} className="border border-gray-300">
                    <input 
                      type="text" 
                      className="w-full p-1 border-0 focus:ring-0 text-center" 
                      placeholder="Dosage"
                    />
                  </td>
                ))}
              </tr>
              {/* Add ability to add more rows */}
              <tr>
                <td className="border border-gray-300 p-2">
                  <input 
                    type="text" 
                    className="w-full p-1 border border-gray-300 rounded" 
                    placeholder="Add another medication"
                  />
                </td>
                {entries.map((entry) => (
                  <td key={`med-extra-${entry}`} className="border border-gray-300">
                    <input 
                      type="text" 
                      className="w-full p-1 border-0 focus:ring-0 text-center" 
                      placeholder="Dosage"
                    />
                  </td>
                ))}
              </tr>
            </tbody>
          </table>
        </div>
      </div>
      
      {/* Insulin Table */}
      <div className="mb-8">
        <h2 className="text-lg font-semibold mb-2">Insulin</h2>
        <div className="overflow-x-auto shadow rounded-lg pb-2">
          <table className="w-full border-collapse border border-gray-400 mb-2">
            <thead>
              <tr className="bg-gray-100">
                <th className="border border-gray-300 p-2 text-left" style={{ minWidth: "120px" }}>Insulin (dosage)</th>
                {entries.map((entry) => (
                  <th key={entry} className="border border-gray-300 p-2" style={{ minWidth: "120px" }}>
                    <div className="flex flex-col gap-1">
                      <input 
                        type="time" 
                        className="text-xs p-1 border rounded w-full"
                      />
                      <input 
                        type="date" 
                        className="text-xs p-1 border rounded w-full"
                      />
                    </div>
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              <tr>
                <td className="border border-gray-300 p-2">
                  <input 
                    type="text" 
                    className="w-full p-1 border border-gray-300 rounded" 
                    placeholder="Insulin type"
                  />
                </td>
                {entries.map((entry) => (
                  <td key={`insulin-${entry}`} className="border border-gray-300">
                    <input 
                      type="text" 
                      className="w-full p-1 border-0 focus:ring-0 text-center" 
                      placeholder="Dosage"
                    />
                  </td>
                ))}
              </tr>
              {/* Add ability to add more rows */}
              <tr>
                <td className="border border-gray-300 p-2">
                  <input 
                    type="text" 
                    className="w-full p-1 border border-gray-300 rounded" 
                    placeholder="Add another insulin"
                  />
                </td>
                {entries.map((entry) => (
                  <td key={`insulin-extra-${entry}`} className="border border-gray-300">
                    <input 
                      type="text" 
                      className="w-full p-1 border-0 focus:ring-0 text-center" 
                      placeholder="Dosage"
                    />
                  </td>
                ))}
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <div className="mt-8 mb-4 text-center">
        <button className="bg-blue-600 hover:bg-blue-700 text-white py-2 px-8 rounded-md shadow-md transition duration-300 ease-in-out transform hover:scale-105">
